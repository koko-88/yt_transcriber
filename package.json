{
  "name": "yt-transcriber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "build:sources": "wxt zip --browser firefox --sources-only",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "zip:all": "npm run zip && npm run zip:firefox && npm run build:sources",
    "postbuild": "npm run check:manifest",
    "compile": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "web-ext:lint": "web-ext lint --source-dir .output/firefox-mv3",
    "prepare": "npm run compile",
    "submit": "wxt submit",
    "submit:dry": "wxt submit --dry-run",
    "build-for-amo": "npm ci && npm run build:firefox"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "idb": "^8.0.2",
    "minisearch": "^7.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@wxt-dev/module-react": "^1.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^18.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.0"
  }
}
